<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ah_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <View
        android:id="@+id/ah_accent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#8E8E93" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ah_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Sin bloque activo" />

        <TextView
            android:id="@+id/ah_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#71717A"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:background="#E5E5E7">
            <View
                android:id="@+id/ah_bar_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="#8E8E93" />
            <View
                android:id="@+id/ah_bar_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="100"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ah_time"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#0A0A0A"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:text="—" />
</LinearLayout>
