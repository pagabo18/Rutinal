<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_habits_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="HÁBITOS DE HOY"
            android:textColor="@color/widgetText2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_habits_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widgetText1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="@drawable/widget_chip"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_habits_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_progress"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/widget_habit_row_1"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_habit_check_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_off"
                android:contentDescription="Marcar" />
            <TextView
                android:id="@+id/widget_habit_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widgetText1"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
            <LinearLayout
            android:id="@+id/widget_habit_row_2"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_habit_check_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_off"
                android:contentDescription="Marcar" />
            <TextView
                android:id="@+id/widget_habit_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widgetText1"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
            <LinearLayout
            android:id="@+id/widget_habit_row_3"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_habit_check_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_off"
                android:contentDescription="Marcar" />
            <TextView
                android:id="@+id/widget_habit_name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widgetText1"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
            <LinearLayout
            android:id="@+id/widget_habit_row_4"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_habit_check_4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_off"
                android:contentDescription="Marcar" />
            <TextView
                android:id="@+id/widget_habit_name_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widgetText1"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
            <LinearLayout
            android:id="@+id/widget_habit_row_5"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_habit_check_5"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_off"
                android:contentDescription="Marcar" />
            <TextView
                android:id="@+id/widget_habit_name_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widgetText1"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
            <LinearLayout
            android:id="@+id/widget_habit_row_6"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_habit_check_6"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_off"
                android:contentDescription="Marcar" />
            <TextView
                android:id="@+id/widget_habit_name_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widgetText1"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_habits_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abre Rutinal para ver tus hábitos"
            android:textColor="@color/widgetText2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
