<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sig_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <View
        android:id="@+id/sig_accent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#8E8E93" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sig_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textColor="#71717A"
            android:letterSpacing="0.08"
            android:text="Siguiente" />

        <TextView
            android:id="@+id/sig_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:text="Sin bloques hoy" />

        <TextView
            android:id="@+id/sig_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#71717A"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/sig_in_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:text="—" />

        <TextView
            android:id="@+id/sig_in_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:textColor="#71717A"
            android:letterSpacing="0.08"
            android:text=" " />
    </LinearLayout>
</LinearLayout>
