<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gw_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gym"
            android:textColor="@color/widgetText2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/gw_rest_k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Descanso"
            android:textColor="@color/widgetText2"
            android:textSize="12sp"
            android:visibility="gone" />

        <Chronometer
            android:id="@+id/gw_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:countDown="true"
            android:textColor="@color/widgetText1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/gw_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_progress"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/gw_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gw_ex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrenamiento"
            android:textColor="@color/widgetText1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/gw_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Abre Rutinal para empezar"
            android:textColor="@color/widgetText2"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gw_plus"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="+30 s"
            android:textColor="@color/widgetText1"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gw_skip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Saltar"
            android:textColor="@color/widgetText1"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gw_done"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_main"
            android:gravity="center"
            android:text="✓ Serie hecha"
            android:textColor="@color/widgetOnMain"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
