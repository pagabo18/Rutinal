<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gw_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gym"
            android:textColor="@color/widgetText2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/gw_rest_k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Descanso"
            android:textColor="@color/widgetText2"
            android:textSize="12sp"
            android:visibility="gone" />

        <Chronometer
            android:id="@+id/gw_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:countDown="true"
            android:textColor="@color/widgetText1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/gw_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/widget_progress"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/gw_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gw_ex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrenamiento"
            android:textColor="@color/widgetText1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/gw_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Abre Rutinal para empezar"
            android:textColor="@color/widgetText2"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Valores de la serie que sigue: peso, repeticiones y RIR con − y + (solo si el widget es alto) -->
    <LinearLayout
        android:id="@+id/gw_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:layout_marginRight="6dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/gw_kg_k"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="KG"
                android:textColor="@color/widgetText2"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_btn"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/gw_kg_m"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/widgetText2"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/gw_kg_v"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="–"
                    android:textColor="@color/widgetText1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/gw_kg_p"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/widgetText2"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:layout_marginRight="6dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/gw_reps_k"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="REPS"
                android:textColor="@color/widgetText2"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_btn"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/gw_reps_m"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/widgetText2"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/gw_reps_v"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="–"
                    android:textColor="@color/widgetText1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/gw_reps_p"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/widgetText2"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_marginRight="0dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/gw_rir_k"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="RIR"
                android:textColor="@color/widgetText2"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_btn"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/gw_rir_m"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/widgetText2"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/gw_rir_v"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="–"
                    android:textColor="@color/widgetText1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/gw_rir_p"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/widgetText2"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gw_plus"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="+30 s"
            android:textColor="@color/widgetText1"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gw_skip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Saltar"
            android:textColor="@color/widgetText1"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gw_done"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_main"
            android:gravity="center"
            android:text="✓ Serie hecha"
            android:textColor="@color/widgetOnMain"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
