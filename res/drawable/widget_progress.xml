<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de avance de los widgets: redondeada y en el color neutro del tema -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="@color/widgetBarBg" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="@color/widgetBar" /></shape></clip>
    </item>
</layer-list>
