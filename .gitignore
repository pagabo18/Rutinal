# Build outputs
build/obj/
build/gen/
build/compiled-res.zip
build/base.apk
build/unsigned.apk
build/aligned.apk
build/classes.dex
build/sources.txt

# Keystores
# keys/debug.keystore SÍ se versiona: es la llave de distribución de los
# builds de GitHub (instalación directa). Sin una llave estable, cada build
# tendría firma distinta y Android rechazaría las actualizaciones.
# La versión de Play Store usará una llave privada aparte (Play App Signing).
build/debug.keystore
*.keystore
*.jks
!keys/debug.keystore

# OS / editores
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.iml

# Logs
*.log

# Gradle build artifacts
android-gradle/**/build/
android-gradle/.gradle/
android-gradle/local.properties

# Assets pesados de gradle (los originales viven en assets/web)
android-gradle/app/src/main/assets/web/

# Screenshots efímeros
screenshot_*.png
